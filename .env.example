# Copy to .env and change the secrets before running: cp .env.example .env

# Flask session signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# PostgreSQL
POSTGRES_DB=clubs
POSTGRES_USER=clubs
POSTGRES_PASSWORD=change-me-db-password

# Grafana admin login (http://localhost:3000)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

# Host ports
WEB_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
